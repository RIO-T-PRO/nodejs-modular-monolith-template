# ==============================================================================
# LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# QUICK START HOW-TO:
# 1. Copy this file right here in the root folder and rename it to '.env'
# 2. DO NOT check your real '.env' file into Git! Keep your passwords private.
# 3. Adjust the placeholder values below to fit your setup.

# --- App Engine Configuration ---
NODE_ENV=development
PORT=4001

# --- Core Database Configurations ---
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_PASSWORD_HERE
DB_NAME=app_db

# --- Database Storage Connection URL ---
# For local Docker Compose, the host name must match the database service ('db').
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}?schema=public

# --- Redis Cache & Messaging Infrastructure ---
REDIS_URL=redis://redis:6379

# --- Security Tokens ---
# CHANGE THIS! Never use the default template key in production environments.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# --- Modular Monolith Messaging Architecture ---
# This controls how separate domain modules talk to each other.
# "memory" = internal event emitters (Zero infra needed, perfect for starting out)
# "redis"  = distributed pub/sub over Redis (When you need to scale modules out later)
MESSAGE_DISPATCHER=memory
