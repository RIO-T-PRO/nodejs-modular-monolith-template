// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  // Outputting into the shared module's src directory so 
  // TypeScript includes it in the rootDir compilation.
  output   = "../src/shared/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}





